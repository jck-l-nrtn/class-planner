# `./plan setup` writes .env (gitignored) for you without echoing the token.
# To do it by hand, copy this file to .env and fill it in. Real environment variables win over .env.

# Canvas ---------------------------------------------------------------
# Your institution's Canvas host (no trailing slash, no /api/v1)
CANVAS_BASE_URL=https://byu.instructure.com
# Personal access token: Canvas > Account > Settings > New Access Token.
# Without it `./plan sync` skips Canvas (reported as "skipped", not a failure).
CANVAS_TOKEN=

# LearningSuite iCal feeds (optional) ----------------------------------
# A feed URL is a credential: anyone holding it can read that course's
# schedule. config/courses.yaml refers to these as ls_ics_url: "${NAME}",
# so the URL itself stays out of the config files. Name each variable
# whatever the courses.yaml entry says. Get the URL from the course Schedule
# page > "Get iCalendar Feed".
# MATH112_ICS=https://learningsuite.byu.edu/iCalFeed/ical.php?courseID=...
# HIST201_ICS=https://learningsuite.byu.edu/iCalFeed/ical.php?courseID=...

# Optional overrides ---------------------------------------------------
# Full path to the AI tool, if `claude`, `codex` or `copilot` is not on PATH
# (launchd jobs start with a minimal PATH). Otherwise it is looked up on PATH,
# then ~/.local/bin, /opt/homebrew/bin and /usr/local/bin.
# CLAUDE_BIN=/full/path/to/claude
# CODEX_BIN=/full/path/to/codex
# COPILOT_BIN=/full/path/to/copilot
# Run everything against a copy of the data instead of data/ and out/:
# PLANNER_DATA_DIR=/tmp/planner-data
# PLANNER_OUT_DIR=/tmp/planner-out

# LearningSuite sign-in is NOT configured here. The browser profile
# (data/.browser-profile) holds the saved password; see docs/LEARNINGSUITE.md.
